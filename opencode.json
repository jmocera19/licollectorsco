{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "small_model": "openai/gpt-5.6-luna",
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "opencode-go/qwen3.8-flash",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "model": "opencode-go/glm-5.3-flash",
      "variant": "high",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "allow",
          "git push": "ask",
          "git push *": "ask"
        }
      }
    }
  }
}
